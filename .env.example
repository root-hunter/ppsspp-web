# open: public access; keys: require an individually issued user key.
RELAY_AUTH_MODE=open

# Hybrid PDP: optional comma-separated ICE URLs. Empty allows LAN/direct host
# candidates; WebSocket remains available when ICE cannot connect.
RELAY_STUN_URLS=
# Configure with an existing coturn deployment using use-auth-secret.
RELAY_TURN_URLS=
RELAY_TURN_SECRET=
RELAY_TURN_TTL=3600
